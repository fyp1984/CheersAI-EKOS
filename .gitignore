# ================= Python =================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# ================= 工具缓存 =================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ================= 密钥与环境变量（红线）=================
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ================= 数据与样本（红线）=================
