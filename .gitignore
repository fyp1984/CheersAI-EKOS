deploy/fixtures/raw/
deploy/fixtures/**/*.pdf
deploy/fixtures/**/*.xlsx
data/
/data/
*.sqlite3

# ================= 模型权重（体积 + 磁盘 226GB 约束）=================
models/
*.gguf
*.safetensors
*.bin
*.pt

# ================= 运行产物 =================
logs/
*.log
reports/output/
记录/*-临时-*

# ================= 编辑器 =================
.idea/
*.swp
.DS_Store

# ================= Obsidian（防止误把仓库放进 vault）=================
.obsidian/
.trash/
