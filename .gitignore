# ================= Python =================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/*

# ================= 工具缓存 =================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ================= 密钥与环境变量（红线）=================
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ================= 数据与样本（红线）=================
# 真实样本一律不入库。fixtures 只放合成数据。
deploy/fixtures/raw/
deploy/fixtures/**/*.pdf
deploy/fixtures/**/*.xlsx
data/
/data/
*.sqlite3

# ================= 模型权重（体积 + 磁盘 226GB 约束）=================
models/
*.gguf
*.safetensors
*.bin
*.pt

# ================= 外部制品仓（L2 · 见 02_方案/11_EKOS外部依赖与制品统一目录规范-v1.0）=================
# 制品（权重/镜像/安装包/二进制）一律不入库；账本在文档仓 03_实施/外部依赖/INVENTORY.yaml
# 注意：用 external/* 而非 external/ —— 父目录被整体忽略时 git 不再递归，
#      其中的 ! 白名单不会被评估（2026-09-10 实测踩坑）。
external/*
!external/README.md

# ================= 白名单（必须覆盖上面的忽略规则）=================
# 冻结清单若被忽略 = 无版本管理，Q6 许可证结论将失去依据 → 强制入库
!dist/offline/
!dist/offline/MANIFEST.sha256
!dist/offline/requirements.txt
dist/offline/.tmp*

# ================= 运行产物 =================
logs/
*.log
reports/output/
记录/*-临时-*

# ================= 编辑器 =================
.idea/
*.swp
.DS_Store

# ================= Obsidian（防止误把仓库放进 vault）=================
.obsidian/
.trash/

# ================= Syncthing（同步工具本地标记）=================
.stfolder/
.stignore
