# EKOS · E0 开发环境环境变量模板
#
# 用法：
#   cp deploy/compose/.env.example deploy/compose/.env
#   然后填写真值
#
# 纪律（契约 X4.4）：
#   · .env 已被仓库 .gitignore 忽略（.env / .env.*，仅 .env.example 放行），绝不提交
#   · compose 内不写口令默认值 —— 缺变量时 compose 直接报错，
#     优于静默使用弱口令（详见 X4.5 判据口径变更说明）
#   · 本模板只放变量名与占位值，任何一行都不允许出现真值

# ---- PostgreSQL（事实库 + 向量库）----
PGUSER=ekos
PGPASSWORD=change_me
PGDATABASE=ekos

# ---- MinIO（对象存储）----
MINIO_USER=ekos
MINIO_PASSWORD=change_me

# ---- 端口（契约 X4.2，开发默认避开 §3.8 冻结段）----
# 不填即用 compose 内的开发默认值
# PGPORT_HOST=15432
# REDISPORT_HOST=16379
# MINIO_API_HOST=19000
# MINIO_CONSOLE_HOST=19001
# MODEL_HOST=18000

# ---- CheersAI Vault（外部脱敏服务，EKOS 只做适配器集成）----
# E0 隔离实例默认 8788；交付端口待甲方拍板（§3.8 未定义，见契约 X4.2）
VAULT_API_BASE_URL=http://127.0.0.1:8788
